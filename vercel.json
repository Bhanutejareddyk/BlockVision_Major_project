{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/upload", "dest": "/public/upload.html" },
    { "src": "/verify", "dest": "/public/verify.html" },
    { "src": "/history", "dest": "/public/history.html" },
    { "src": "/dashboard", "dest": "/public/dashboard.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
