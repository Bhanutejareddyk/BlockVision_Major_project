# BlockVision 2.0 Environment Configuration
# Copy this file to .env and fill in real values

# Blockchain / Web3 Configuration
ETHEREUM_NODE_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0x386121D53702e5C25F071d7c34b1767C7707e77d
ADMIN_PRIVATE_KEY=
WEB3_NETWORK=sepolia

# JWT Authentication
SECRET_KEY=blockvision_super_secure_jwt_secret_key_change_in_production

# Gmail SMTP Configuration (Real-time Email OTP)
# IMPORTANT: For Gmail, use an 16-character App Password, NOT your regular password.
# 1. Enable 2-Step Verification in Google Account Settings
# 2. Go to Security -> App passwords -> Create an app password for 'Mail' / 'BlockVision'
# 3. Paste the 16-character code below as SMTP_PASS without spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# IPFS Pinata Configuration
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# Application URL
APP_URL=https://blockvision-nu.vercel.app
